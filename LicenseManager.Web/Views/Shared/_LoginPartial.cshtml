@*Kokias nuorodas rodyti navigacijos juostoje, priklausomai nuo to, ar naudotojas yra prisijungęs*@

@using Microsoft.AspNetCore.Identity

@*Per dependency injection gaunamas prisijungimo būseną valdantis objektas.*@
@inject SignInManager<IdentityUser> SignInManager

<ul class="navbar-nav">
    @*Jei naudotojas prisijungęs, rodomas vardas ir atsijungimas.*@
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="nav-link text-dark">
                @User.Identity?.Name
            </span>
        </li>

        <li class="nav-item">
            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="/"
                  method="post">
                <button type="submit"
                        class="nav-link btn btn-link text-dark">
                    Atsijungti
                </button>
            </form>
        </li>
    }
    else  @*Neprisijungusiam rodomos registracijos ir prisijungimo nuorodos.*@
    {
        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-area="Identity"
               asp-page="/Account/Register">
                Registruotis
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-area="Identity"
               asp-page="/Account/Login">
                Prisijungti
            </a>
        </li>
    }
</ul>